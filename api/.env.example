# Copy to .env for local runs. `npm run dev` loads it. Never commit .env.
PORT=3000
# Legacy MariaDB database. Required. This URL matches the Compose database (npm run services:up).
# Production sets it as an App Service setting; special characters in the password need URL encoding.
DATABASE_URL=mariadb://megabucks:bowling4money@localhost:15306/bowling_megabucks
# The key the registration site sends in the x-api-key header. Required, 32 characters or more.
# Production sets it as an App Service setting. Make a new one: openssl rand -base64 32
API_KEY=api_localKey_thisIsForTestingOnly
# Signs the sign-in cookie. Required, 32 characters or more. Not the same value as API_KEY.
# Production sets it as an App Service setting. Make a new one: openssl rand -base64 32
AUTH_SECRET=auth_localSecret_thisIsForTestingOnly
# The API's own address: scheme and host, no path. Production: https://api.bowlingmegabucks.com
AUTH_BASE_URL=http://localhost:3000
# Comma-separated pages allowed to call the API from a browser. Better Auth trusts the same list for
# sign-in (a POST from any other page is refused). Locally this is the Vite dev server, which proxies
# /api. Production: https://bowlingmegabucks.com,https://www.bowlingmegabucks.com
CORS_ORIGIN=http://localhost:5173

# Rate limit: requests per client IP per window. Over the limit gets a 429.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
# Reverse proxies in front of the API. 0 locally. 1 on Azure App Service (set it there).
TRUST_PROXY=0

# fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=info

# Telemetry. Leave both empty to export nothing.
# Local Seq (npm run services:up from the repo root). Logs, traces, and metrics all go here.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:15341/ingest/otlp
# Only for a Seq that needs an API key: OTEL_EXPORTER_OTLP_HEADERS=X-Seq-ApiKey=your-key
# Azure sets this when Application Insights is on.
APPLICATIONINSIGHTS_CONNECTION_STRING=
