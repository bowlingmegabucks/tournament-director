{
  "name": "api",
  "private": true,
  "version": "1.0.0-rc.2",
  "type": "module",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import ./src/instrumentation.ts src/server.ts",
    "db:generate": "prisma generate",
    "db:tables": "node --env-file-if-exists=.env src/test/createTables.ts",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.ts",
    "encryption:check": "node --env-file-if-exists=.env src/db/checkEncryption.ts",
    "users:create-admin": "node --env-file-if-exists=.env src/db/createAdmin.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node --import ./dist/instrumentation.js dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:fast": "stryker run --ignoreStatic"
  },
  "dependencies": {
    "@azure/monitor-opentelemetry-exporter": "1.0.0-beta.46",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-pino": "^0.71.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.38.0",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@scalar/express-api-reference": "^0.10.40",
    "better-auth": "^1.7.27",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "import-in-the-middle": "^3.6.0",
    "nodemailer": "^10.6.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testcontainers/mariadb": "^12.2.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "globals": "^17.14.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.2",
    "typescript-eslint": "^8.73.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "qs": "^6.16.1",
    "minimatch": "^11.0.3",
    "glob": "^14.0.3",
    "effect": "^3.22.5"
  }
}
