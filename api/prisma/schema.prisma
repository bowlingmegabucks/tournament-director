// Maps the legacy MariaDB schema (docs/migration/database.md). Models only the tables a
// shipped feature reads (D-30). WinForms owns the schema: never run `prisma migrate` here.
generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "ts"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "mysql"
}

model Tournament {
  id            String   @id @map("Id") @db.Char(36)
  name          String   @map("Name") @db.LongText
  start         DateTime @map("Start") @db.DateTime(6)
  end           DateTime @map("End") @db.DateTime(6)
  entryFee      Decimal  @map("EntryFee") @db.Decimal(5, 2)
  /// Games per qualifying squad (TRN-04). A sweeper sets its own.
  games         Int      @map("Games") @db.SmallInt
  /// 1 in N advance. A squad may override it; the squad list needs the default (TRN-12).
  finalsRatio   Decimal  @map("FinalsRatio") @db.Decimal(3, 1)
  cashRatio     Decimal  @map("CashRatio") @db.Decimal(3, 1)
  /// 1 in N super sweeper bowlers cash (TRN-09). Column name has a typo: "Sweper". May hold the legacy 0 (D-17).
  superSweeperCashRatio Decimal @map("SuperSweperCashRatio") @db.Decimal(3, 1)
  bowlingCenter String   @map("BowlingCenter") @db.LongText
  /// Nothing in legacy sets this to true, and create writes false (D-119). Read by the settings route and the edit rules, which freeze a complete tournament (D-130, D-131).
  completed     Boolean  @map("Completed")
  squads        Squad[]

  @@map("Tournaments")
}

model Division {
  id                     String            @id @map("Id") @db.Char(36)
  name                   String            @map("Name") @db.LongText
  number                 Int               @map("Number") @db.SmallInt
  tournamentId           String            @map("TournamentId") @db.Char(36)
  minimumAge             Int?              @map("MinimumAge") @db.SmallInt
  maximumAge             Int?              @map("MaximumAge") @db.SmallInt
  minimumAverage         Int?              @map("MinimumAverage")
  maximumAverage         Int?              @map("MaximumAverage")
  handicapPercentage     Decimal?          @map("HandicapPercentage") @db.Decimal(3, 2)
  handicapBase           Int?              @map("HandicapBase")
  maximumHandicapPerGame Int?              @map("MaximumHandicapPerGame")
  /// 0 = Male, 1 = Female, NULL = any gender (docs/migration/database.md)
  gender                 Int?              @map("Gender")
  sweeperPins            SweeperDivision[]
  registrations          Registration[]

  @@map("Divisions")
}

/// Squads and sweepers share this table (EF "table per hierarchy"): squadType 0 is a squad,
/// 1 is a sweeper. Columns that do not apply to a row's type are NULL.
model Squad {
  id              String              @id @map("Id") @db.Char(36)
  tournamentId    String              @map("TournamentId") @db.Char(36)
  squadType       Int                 @map("SquadType")
  date            DateTime            @map("Date") @db.DateTime(6)
  /// Squad: optional override. Sweeper: its own required cash ratio.
  cashRatio       Decimal?            @map("CashRatio") @db.Decimal(3, 1)
  maxPerPair      Int                 @map("MaxPerPair") @db.SmallInt
  startingLane    Int                 @map("StartingLane") @db.SmallInt
  numberOfLanes   Int                 @map("NumberOfLanes") @db.SmallInt
  complete        Boolean             @map("Complete")
  finalsRatio     Decimal?            @map("FinalsRatio") @db.Decimal(3, 1)
  squadEntryFee   Decimal?            @map("SquadEntryFee") @db.Decimal(5, 2)
  sweeperEntryFee Decimal?            @map("SweeperEntryFee") @db.Decimal(5, 2)
  games           Int?                @map("Games") @db.SmallInt
  /// The tournament it belongs to, for the fee and ratios a squad falls back on (TRN-12).
  tournament      Tournament          @relation(fields: [tournamentId], references: [id])
  /// Bonus pins, for a sweeper.
  pins            SweeperDivision[]
  /// Who bowls this squad or sweeper (REG-24).
  entries         SquadRegistration[]

  @@map("Squads")
}

/// Bonus pins per game for one division in one sweeper. NULL counts as 0.
model SweeperDivision {
  sweeperId        String   @map("SweeperId") @db.Char(36)
  divisionId       String   @map("DivisionId") @db.Char(36)
  bonusPinsPerGame Int?     @map("BonusPinsPerGame")
  sweeper          Squad    @relation(fields: [sweeperId], references: [id])
  division         Division @relation(fields: [divisionId], references: [id])

  @@id([sweeperId, divisionId])
  @@map("SweeperDivision")
}

/// A person. The registration list reads a few columns (D-47); registration create reads and
/// writes the rest (D-05). `socialSecurityNumber` is encrypted and only legacy writes it: the client
/// omits it from every read (see `createDatabaseClient`), create sends `''`, and no update names it
/// (BWL-17).
model Bowler {
  id                   String         @id @map("Id") @db.Char(36)
  firstName            String         @map("FirstName") @db.LongText
  /// '' when none.
  middleInitial        String         @map("MiddleInitial") @db.Char(1)
  lastName             String         @map("LastName") @db.LongText
  /// '' when none.
  suffix               String         @map("Suffix") @db.LongText
  /// '' when none.
  street               String         @map("StreetAddress") @db.LongText
  city                 String         @map("CityAddress") @db.LongText
  state                String         @map("StateAddress") @db.Char(2)
  /// 5 or 9 digits, no dash.
  zipCode              String         @map("ZipCode") @db.Char(9)
  email                String         @map("EmailAddress") @db.LongText
  /// 10 digits, or ''.
  phoneNumber          String         @map("PhoneNumber") @db.Char(10)
  /// '' when none.
  usbcId               String         @map("USBCId") @db.LongText
  dateOfBirth          DateTime?      @map("DateOfBirth") @db.DateTime(6)
  /// 0 = Male, 1 = Female, NULL = unknown.
  gender               Int?           @map("Gender")
  socialSecurityNumber String         @default("") @map("SocialSecurityNumber") @db.LongText
  registrations        Registration[]

  @@map("Bowlers")
}

/// One bowler in one division (REG-01). The tournament comes from the division: the table has no
/// TournamentId column (Q-26).
model Registration {
  id           String              @id @map("Id") @db.Char(36)
  bowlerId     String              @map("BowlerId") @db.Char(36)
  divisionId   String              @map("DivisionId") @db.Char(36)
  /// Drives handicap (SCR-07). NULL means no average.
  average      Int?                @map("Average")
  superSweeper Boolean             @map("SuperSweeper")
  bowler       Bowler              @relation(fields: [bowlerId], references: [id])
  division     Division            @relation(fields: [divisionId], references: [id])
  squads       SquadRegistration[]
  payments     Payment[]

  @@map("Registrations")
}

/// Money the registration site took, sent with a registration (PAY-02). Deleted with its
/// registration. `confirmationCode` is `<processingSystem>_<code>` and unique (PAY-03).
model Payment {
  id               String       @id @map("Id") @db.Char(36)
  createdAtUtc     DateTime     @map("CreatedAtUtc") @db.DateTime(6)
  registrationId   String       @map("RegistrationId") @db.Char(36)
  confirmationCode String       @unique(map: "IX_Payments_ConfirmationCode") @map("ConfirmationCode") @db.VarChar(43)
  amount           Decimal      @map("Amount") @db.Decimal(5, 2)
  registration     Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId], map: "IX_Payments_RegistrationId")
  @@map("Payments")
}

/// A registration bowling one squad or sweeper (REG-24). `laneAssignment` is the position, such as
/// `15A` (LAN-01). The column is NOT NULL with default '' in the legacy table; the model reads NULL
/// too, since both mean "not assigned" (D-58).
model SquadRegistration {
  registrationId String       @map("RegistrationId") @db.Char(36)
  squadId        String       @map("SquadId") @db.Char(36)
  laneAssignment String?      @map("LaneAssignment") @db.VarChar(3)
  registration   Registration @relation(fields: [registrationId], references: [id])
  squad          Squad        @relation(fields: [squadId], references: [id])

  @@id([registrationId, squadId])
  @@map("SquadRegistration")
}

/// One game score for one bowler in one squad or sweeper, in scratch pins (storage section of
/// `scores.md`). Read only for the score view (D-69). Linked to the bowler, not the registration,
/// and modeled without relations: the view joins them in code.
model SquadScore {
  bowlerId String @map("BowlerId") @db.Char(36)
  squadId  String @map("SquadId") @db.Char(36)
  /// 1-based.
  game     Int    @map("Game") @db.SmallInt
  score    Int    @map("Score")

  @@id([bowlerId, squadId, game])
  @@map("SquadScores")
}

// Sign-in tables for Better Auth (D-98, D-100). Created by prisma/auth-tables.sql, not by Prisma.
// Better Auth reads and writes these through its Prisma adapter; routes never query them directly.
// Names and columns are the ones Better Auth expects, so do not rename them.

/// A person who can sign in. `role` holds one of the roles in `shared/auth/roles.ts` (D-97).
model User {
  id            String    @id @db.VarChar(36)
  name          String    @db.VarChar(255)
  email         String    @unique(map: "user_email_key") @db.VarChar(255)
  emailVerified Boolean   @default(false)
  image         String?   @db.Text
  createdAt     DateTime  @default(now()) @db.DateTime(3)
  updatedAt     DateTime  @default(now()) @db.DateTime(3)
  role          String?   @db.VarChar(64)
  banned        Boolean?  @default(false)
  banReason     String?   @db.Text
  banExpires    DateTime? @db.DateTime(3)
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

/// One sign-in. Better Auth looks it up by the cookie's token on each request (D-99).
model Session {
  id             String   @id @db.VarChar(36)
  expiresAt      DateTime @db.DateTime(3)
  token          String   @unique(map: "session_token_key") @db.VarChar(255)
  createdAt      DateTime @default(now()) @db.DateTime(3)
  updatedAt      DateTime @db.DateTime(3)
  ipAddress      String?  @db.VarChar(64)
  userAgent      String?  @db.Text
  userId         String   @db.VarChar(36)
  impersonatedBy String?  @db.VarChar(36)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "session_userId_fkey")

  @@index([userId], map: "session_userId_idx")
  @@map("session")
}

/// How a user proves who they are. Email and password is `providerId` `credential`, and `password`
/// holds the salted hash.
model Account {
  id                    String    @id @db.VarChar(36)
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(64)
  userId                String    @db.VarChar(36)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.DateTime(3)
  refreshTokenExpiresAt DateTime? @db.DateTime(3)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @db.DateTime(3)
  updatedAt             DateTime  @db.DateTime(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "account_userId_fkey")

  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

/// A one-time token, for password reset and invites (stage 3, D-101).
model Verification {
  id         String   @id @db.VarChar(36)
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @db.DateTime(3)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @default(now()) @db.DateTime(3)

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}

/// The skip pattern (`staggered` or `same`, LAN-19) of one squad or sweeper (D-235). Created by
/// prisma/score-tables.sql, not by Prisma, and unknown to WinForms. No row means staggered.
model SessionSkip {
  sessionId String @id @map("SessionId") @db.Char(36)
  skip      String @map("Skip") @db.VarChar(16)

  @@map("SessionSkip")
}
