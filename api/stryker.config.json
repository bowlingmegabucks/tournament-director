{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/server.ts",
    "!src/instrumentation.ts",
    "!src/test/**",
    "!src/db/seed.ts",
    "!src/generated/**",
    "!src/features/tournaments/prismaRepository.ts",
    "!src/features/divisions/prismaRepository.ts",
    "!src/features/squads/prismaRepository.ts",
    "!src/features/sweepers/prismaRepository.ts",
    "!src/db/seedTournaments.ts",
    "!src/db/seedDivisions.ts",
    "!src/db/seedSessions.ts"
  ],
  "reporters": ["clear-text", "html"],
  "dashboard": {
    "module": "api"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  }
}
