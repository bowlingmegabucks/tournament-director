{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.app.json",
  "mutate": [
    "src/**/*.{ts,tsx}",
    "!src/**/*.test.{ts,tsx}",
    "!src/main.tsx",
    "!src/mocks/**",
    "!src/test/**",
    "!src/vite-env.d.ts"
  ],
  "incremental": true,
  "reporters": ["clear-text", "html"],
  "dashboard": { "module": "web" },
  "thresholds": { "high": 80, "low": 60, "break": 50 }
}
